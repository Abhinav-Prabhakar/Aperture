{
  "name": "aperture",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "dev": "turbo run dev",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "registry:build": "shadcn build --output apps/web/public/r",
    "registry:check": "shadcn build --output .registry-check",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "shadcn": "4.1.0",
    "turbo": "2.6.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.1"
  }
}
